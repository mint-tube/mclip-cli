{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "C/C++ gdb",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/mclip",
      "args": [
        "${input:userArgs}"
      ],
      "cwd": "${fileDirname}",
      "MIMode": "gdb",
      "setupCommands": [
        {
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "text": "-gdb-set disassembly-flavor intel",
          "ignoreFailures": true
        }
      ]
    }
  ],
  "inputs": [
    {
      "id": "userArgs",
      "type": "promptString",
      "description": "Enter arguments for the program"
    }
  ]
}